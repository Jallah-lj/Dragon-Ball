{
  "name": "dragon-ball-forest-chase",
  "version": "1.0.0",
  "private": true,
  "description": "Dragon Ball: Forest Chase \u2014 a browser-based forest runner where a dragon chases a magical fireball. Solo play, teams and real-time races.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,green \"npm run dev -w @dbfc/server\" \"npm run dev -w @dbfc/web\"",
    "build": "npm run build -w @dbfc/web && npm run build -w @dbfc/server",
    "start": "npm run start -w @dbfc/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project web",
    "test:integration": "vitest run --project server",
    "test:e2e": "playwright test",
    "balance": "tsx packages/shared/scripts/balance.ts",
    "db:generate": "npm run db:generate -w @dbfc/server",
    "db:migrate": "npm run db:migrate -w @dbfc/server",
    "db:seed": "npm run db:seed -w @dbfc/server",
    "build:e2e": "npm run build:e2e -w @dbfc/web && npm run build -w @dbfc/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
