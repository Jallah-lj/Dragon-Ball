# ---------------------------------------------------------------------------
# Dragon Ball: Forest Chase — environment configuration (example values only).
# Copy to `.env` and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Public origin of the web app (used for invite links, emails and CORS/Origin checks).
PUBLIC_URL=http://localhost:5173
# Extra allowed browser origins for the API/WebSocket (comma separated).
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a TLS-terminating proxy (secure cookies, client IPs).
TRUST_PROXY=false

# Database
#   pglite://./.data/pglite            → embedded PGlite on disk (zero-setup local dev; the default)
#   postgres://user:pass@host:5432/db  → PostgreSQL (production; `docker compose up -d postgres`)
#   pglite://memory                    → in-memory PGlite (tests)
DATABASE_URL=pglite://./.data/pglite
# DATABASE_URL=postgres://dbfc:dbfc_dev_password@localhost:5432/dbfc
# Run pending migrations automatically when the server starts.
AUTO_MIGRATE=true

# Redis (optional). Enables multi-instance Socket.IO, shared rate limits and race-room state.
# Leave empty to use in-memory implementations (single instance).
REDIS_URL=

# Sessions
SESSION_TTL_DAYS=30
# Secret used to sign CSRF tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Email (optional). Without SMTP settings, verification/reset emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Forest Chase <no-reply@example.com>"

# Real-time races
RACE_MIN_PLAYERS=2

# Anti-cheat: a run must take at least this fraction of its simulated time in real time.
RUN_MIN_WALLCLOCK_RATIO=0.9
RATE_LIMIT_ENABLED=true

# Content-Security-Policy frame-ancestors. Keep 'self' unless the app must be embedded.
FRAME_ANCESTORS='self'
# Cookie SameSite policy: lax (default). Use none only when embedding the app in a cross-site iframe.
COOKIE_SAMESITE=lax

# Production: directory of the built web client (defaults to apps/web/dist when present).
STATIC_DIR=

# Web client (Vite). Only needed if the API is served from a different origin.
VITE_API_URL=
